# See : https://github.com/go-gitea/gitea/blob/release/v1.27/custom/conf/app.example.ini

# Gitea - Mailer
GITEA_MAILER_ENABLED=true
GITEA_MAILER_FROM="<user>@clapas.org"
GITEA_MAILER_PROTOCOL="smtps"
GITEA_MAILER_SMTP_ADDR="ssl0.ovh.net"
GITEA_MAILER_SMTP_PORT="587"
GITEA_MAILER_USER="<user>@clapas.org"
GITEA_MAILER_PASSWD="<password>"

# Gitea - Security
#GITEA_SECURITY_SECRET_KEY=""
#GITEA_SECURITY_INTERNAL_TOKEN=""

# Gitea - Service
GITEA_SERVICE_DISABLE_REGISTRATION=true
