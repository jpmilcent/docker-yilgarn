# Docker
# To authorize telgraf to access to /run/docker.sock set host docker gid
# Find docker gid with: stat -c '%g' /var/run/docker.sock
# Or run docker-compose like this:
DOCKER_GID=1000

# Influxdb 2 initialize
INFLUXDB2_INIT_USERNAME=<user-name>
INFLUXDB2_INIT_PASSWORD=<user-password>
INFLUXDB2_INIT_ORG=
INFLUXDB2_INIT_BUCKET=yilgarn
INFLUXDB2_INIT_RETENTION=365d
INFLUXDB2_INIT_ADMIN_TOKEN=<uuid-for-example>

# Influxdb 2 for Telegraf
INFLUXDB2_TELEGRAF_TOKEN=<use-influxdb2-web-inteface-to-get-it>
