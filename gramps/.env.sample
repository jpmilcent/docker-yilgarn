
# Gramps config
# Command to see tree name : gramps -l
GRAMPSWEB_BASE_URL="https://gramps.example.com"
GRAMPSWEB_TREE="<your-tree-name>"
GRAMPSWEB_CELERY_CONFIG__broker_url="redis://gramps-redis:6379/0"
GRAMPSWEB_CELERY_CONFIG__result_backend="redis://gramps-redis:6379/0"
GRAMPSWEB_RATELIMIT_STORAGE_URI="redis://gramps-redis:6379/1"

# The secret key for flask.
# This must be set for use in production.
# The secret must not be shared publicly. Changing it will invalidate all access tokens
# Command to generate one secret key : python3 -c "import secrets;print(secrets.token_urlsafe(32))"
GRAMPSWEB_SECRET_KEY=''

# Configure email
GRAMPSWEB_EMAIL_HOST="mail.example.com"
GRAMPSWEB_EMAIL_PORT=587
GRAMPSWEB_EMAIL_USE_TLS=True
GRAMPSWEB_EMAIL_HOST_USER="<user-email>"
GRAMPSWEB_EMAIL_HOST_PASSWORD='<user-password>'
GRAMPSWEB_DEFAULT_FROM_EMAIL="gramps@example.com"

# Gunicorn
# Limit Gunicorn workers number
GUNICORN_NUM_WORKERS=2