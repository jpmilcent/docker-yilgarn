# URL
APP_FULL_BASE_URL=https://my.domain.com
PASSBOLT_SSL_FORCE=false

# Database settings
DATASOURCES_DEFAULT_HOST=<docker-database-container-name>
DATASOURCES_DEFAULT_PORT=3306
DATASOURCES_DEFAULT_USERNAME=
DATASOURCES_DEFAULT_PASSWORD=
DATASOURCES_DEFAULT_DATABASE=

# Registration
PASSBOLT_REGISTRATION_PUBLIC=false

# Email
EMAIL_TRANSPORT_DEFAULT_CLASS_NAME=Smtp
EMAIL_DEFAULT_FROM=
EMAIL_TRANSPORT_DEFAULT_HOST=
EMAIL_TRANSPORT_DEFAULT_PORT=
EMAIL_TRANSPORT_DEFAULT_USERNAME=
EMAIL_TRANSPORT_DEFAULT_PASSWORD=
EMAIL_TRANSPORT_DEFAULT_TLS=true

# Mobile App
PASSBOLT_PLUGINS_JWT_AUTHENTICATION_ENABLED=TRUE
PASSBOLT_PLUGINS_MOBILE_ENABLED=TRUE
