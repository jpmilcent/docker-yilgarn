# Password for Admin user
ADMIN_PASSWORD=your_admin_password

# Encrypted password for Admin user
ENCRYPTED_PASSWORD=your_admin_password_bcrypt_encrypted

# Hostname get from host
# WARNING: HOSTNAME need to be exported ! See: https://forums.docker.com/t/docker-compose-not-seeing-environment-variables-on-the-host/11837/12
HOSTNAME=${HOSTNAME}
# Your domain (or domains) = Main domain for SSL certificate
DOMAIN=manager.mydomain.com

# Network name
# Your container app must use a network conencted to your webproxy
# https://github.com/evertramos/docker-compose-letsencrypt-nginx-proxy-companion
NETWORK=nginx-proxy
