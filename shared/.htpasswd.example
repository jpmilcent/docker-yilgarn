# Modèle uniquement — ne pas monter ce fichier dans Nginx.
# Créez shared/.htpasswd avec :
# docker run --rm -it \
#   -v "$PWD/shared:/work" \
#   httpd:2.4-alpine \
#   htpasswd -cB /work/.htpasswd <utilisateur>
# Pour ajouter un autre utilisateur :
# docker run --rm -it \
#   -v "$PWD/shared:/work" \
#   httpd:2.4-alpine \
#   htpasswd -B /work/.htpasswd <autre_utilisateur>
